# Local demo only. For production, use the settings below and remove NBC_DEMO_OTP.
NBC_RUNTIME_MODE=demo
OTP_PROVIDER=fake
NBC_DATA_DIR=.data/nbc
# Explicit local simulation fixture; never returned by APIs or deployed to production.
NBC_DEMO_OTP=739281
NBC_DEMO_MODE=false
NBC_ALLOW_REMOTE_DEMO=false

# Production: NBC_RUNTIME_MODE=production and OTP_PROVIDER=unifonic.
# Fresh managed PostgreSQL, UTF8 encoding, TLS, backups and connection pooling.
DATABASE_URL=
# Optional custom database root CA as PEM (Supabase). Keep URL free of SSL query options with this set.
DATABASE_SSL_CA=
UNIFONIC_APP_SID=
OTP_SENDER_ID=
# Independent random keys, each at least 32 bytes encoded as 64 hex characters.
OTP_HMAC_SECRET=
IDENTITY_LOOKUP_SECRET=
# Exact HTTPS origin, no path. Never use NEXT_PUBLIC_ for secrets.
NBC_PUBLIC_ORIGIN=

# Cloudflare Access staff application. Protected paths are listed in deployment docs.
# Alternatively set NBC_STAFF_AUTH=vercel for the visible Vercel sign-in button.
NBC_STAFF_AUTH=cloudflare
VERCEL_APP_CLIENT_ID=
# Independent random 32-byte hex key for encrypted, one-hour staff sessions.
NBC_STAFF_SESSION_SECRET=
# Stable Vercel user IDs, never usernames or email addresses.
NBC_VERCEL_ADMIN_SUBJECTS=
NBC_VERCEL_EDITOR_SUBJECTS=
CF_ACCESS_ISSUER=
CF_ACCESS_AUD=
# Comma-separated immutable sub claims, not emails or browser-supplied roles.
NBC_ADMIN_SUBJECTS=
NBC_EDITOR_SUBJECTS=
# Set true only after enforcing and testing the Access/IdP MFA policy.
NBC_STAFF_MFA_CONFIRMED=false
# cf-connecting-ip or x-vercel-forwarded-for; proxy must overwrite it.
# Block access around the trusted proxy. Never trust client-supplied headers.
NBC_TRUSTED_IP_HEADER=
