{
  "name": "nbc-competition-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "node tests/integration.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/*.{ts,mjs}\" \"scripts/*.mjs\" next.config.ts package.json tsconfig.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/*.{ts,mjs}\" \"scripts/*.mjs\" next.config.ts package.json tsconfig.json",
    "db:migrate": "tsx scripts/migrate.mjs",
    "db:cleanup": "tsx scripts/cleanup.mjs",
    "test:postgres": "node tests/postgres.mjs",
    "test:admin-access": "node tests/admin-access.mjs",
    "prebuild": "node scripts/prepare-book.mjs",
    "predev": "node scripts/prepare-book.mjs",
    "questions:import": "tsx scripts/import-questions.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fontsource/noto-naskh-arabic": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "jose": "6.2.12",
    "motion": "13.2.0",
    "next": "16.3.8",
    "openid-client": "6.8.8",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "embedded-postgres": "18.4.0-beta.17",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
